# PostgreSQL connection string (docker compose default)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sizzle?schema=public"
# Used by the integration tests (they wipe this database!)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sizzle_test?schema=public"
# HTTP port of the API server
PORT=3001
HOST=0.0.0.0
# Comma separated list of allowed browser origins in development
CORS_ORIGIN="http://localhost:5173"
# Secret used to sign cookies – change this in production!
COOKIE_SECRET="change-me-to-a-long-random-string"
# Session lifetime in days
SESSION_TTL_DAYS=30
# development | production | test
NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=info
# Absolute or relative path to the built client (served in production)
CLIENT_DIST="../client/dist"
